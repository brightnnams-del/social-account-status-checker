const commonLimitations = [
  "A public profile lookup does not reveal private enforcement or account-health information.",
  "A profile that is missing, private, renamed, deleted, or temporarily unavailable is not proof of a restriction."
];

function unknown(platform, details, nextSteps = []) {
  return {
    platformStatus: "NOT_CONFIRMED",
    status: "UNKNOWN",
    confidence: "none",
    summary: `${platform} restriction status could not be confirmed.`,
    details,
    limitations: commonLimitations,
    nextSteps: [
      ...nextSteps,
      "Sign in to the official platform app or website.",
      "Review account status, support inbox, policy notices, and appeal options."
    ]
  };
}

export async function getProviderAssessment({ platform }) {
  switch (platform) {
    case "instagram":
      return unknown("Instagram", "Meta does not provide a universal public API that checks restrictions for any username. Account owners should use Instagram's Account Status screen.", ["Open Instagram → Settings and activity → Account Status."]);
    case "facebook":
      return unknown("Facebook", "Meta does not provide a universal public API that checks restrictions for any username. Account owners should review Account Status and Support Inbox.", ["Open Facebook → Help & support → Support Inbox; also review Account Status if available."]);
    case "tiktok":
      return unknown("TikTok", "TikTok's approved APIs provide selected user-authorized data, not a general public username restriction verdict.", ["Open TikTok → Profile → Menu → Settings and privacy → Account status, if available."]);
    case "x":
      return unknown("X", "X API profile data does not establish whether an account has an enforcement or visibility restriction.", ["Sign in to X and review any account notices, account access alerts, and appeal instructions."]);
    case "youtube":
      return unknown("YouTube", "YouTube Data API can provide public channel metadata, but does not provide a universal private channel-standing verdict.", ["Open YouTube Studio → Channel violations / policy notices."]);
    case "snapchat":
      return unknown("Snapchat", "Snap Kit is not a public username restriction-checking API.", ["Use Snapchat's official account unlock and support pages while signed in as the account owner."]);
    default:
      return unknown("This platform", "The selected platform is not supported.");
  }
}
