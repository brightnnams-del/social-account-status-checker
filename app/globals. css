:root{font-family:Inter,ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;color:#f4f7e8;background:#080a07;font-synthesis:none}*{box-sizing:border-box}body{margin:0;background:radial-gradient(ellipse at 50% -10%,#334b12 0,transparent 48%),#080a07;min-height:100vh}.topbar{height:76px;border-bottom:1px solid #34421d;display:flex;align-items:center;justify-content:space-between;padding:0 max(calc((100% - 1080px)/2),24px)}.brand{display:flex;gap:10px;align-items:center;color:#f7ffe9;text-decoration:none;font-weight:750;letter-spacing:-.3px}.brand-mark{display:grid;place-items:center;width:30px;height:30px;border-radius:9px;background:#b7e326;color:#11150a}.top-note{font-size:12px;color:#a4ae8a}.shell{max-width:900px;margin:0 auto;padding:70px 24px}.hero{text-align:center;margin-bottom:34px}.eyebrow{font-size:10px;letter-spacing:2px;color:#c5ed45;font-weight:800}.hero h1{font-size:clamp(36px,6vw,58px);line-height:1.04;letter-spacing:-2px;margin:15px 0;color:#f5f8ec}.hero h1 span{color:#c5ed45}.intro{color:#b7c0a3;max-width:610px;margin:0 auto;line-height:1.7;font-size:15px}.panel,.report{background:#14180f;border:1px solid #3d4b24;border-radius:18px;padding:28px;box-shadow:0 18px 60px #0007}.panel{max-width:610px;margin:0 auto}.field{margin-bottom:20px}.field>label{display:block;font-size:13px;font-weight:650;margin-bottom:9px;color:#eff5df}select,input:not([type=radio]){width:100%;background:#090c07;border:1px solid #46542c;border-radius:10px;padding:14px;color:#f5f8ec;font:inherit;outline:none}select:focus,input:focus{border-color:#c5ed45}.segmented{display:flex;background:#090c07;border:1px solid #46542c;padding:4px;border-radius:10px}.segmented label{flex:1;cursor:pointer}.segmented input{position:absolute;opacity:0}.segmented span{display:block;text-align:center;padding:9px;border-radius:7px;color:#a8b294;font-size:13px}.segmented input:checked+span{background:#35451a;color:#eaffad}.field small{display:block;color:#929e7a;font-size:11px;line-height:1.5;margin-top:8px}button{border:0;cursor:pointer;font:inherit}#submit{width:100%;display:flex;justify-content:space-between;align-items:center;padding:15px 17px;border-radius:10px;background:linear-gradient(100deg,#a6cf19,#d4f34d);color:#111609;font-weight:800}#submit:disabled{opacity:.6;cursor:wait}.error{color:#ffb0a6;background:#321b15;border:1px solid #75402c;padding:12px;border-radius:9px;margin-top:14px}.report{margin:30px auto 0;max-width:760px}.report-head{display:flex;align-items:center;justify-content:space-between;gap:15px;margin-bottom:20px}.report h2{margin:7px 0 0;font-size:24px;color:#f5f8ec}.secondary{padding:10px 13px;border-radius:8px;background:#303a20;color:#eaffad;font-size:12px;border:1px solid #566b2c}.status-card{border:1px solid #52652a;background:#1a2111;border-radius:12px;padding:20px}.pill{display:inline-block;padding:5px 9px;border-radius:99px;background:#394b19;color:#dfff87;font-size:10px;font-weight:800;letter-spacing:1px}.status-card h3{font-size:18px;margin:13px 0 6px;color:#f5f8ec}.status-card p{color:#b7c0a3;line-height:1.6;font-size:13px;margin:0}.report-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;margin:14px 0}.metric{background:#0b0e08;border:1px solid #34421d;border-radius:10px;padding:13px}.metric span{display:block;color:#9ca987;font-size:10px;margin-bottom:7px}.metric strong{font-size:12px;overflow-wrap:anywhere;color:#f0f5df}.report-section{margin-top:22px}.report-section h3{font-size:14px;color:#eef5dd}.report-section ul{color:#b7c0a3;font-size:13px;line-height:1.8;padding-left:19px}.disclaimer{color:#929e7a;font-size:11px;line-height:1.6;border-top:1px solid #34421d;padding-top:14px;margin-top:22px}.how{margin:58px 0 30px}.how h2{text-align:center;font-size:21px;color:#f5f8ec}.steps{display:grid;grid-template-columns:repeat(3,1fr);gap:18px;margin-top:24px}.steps>div{background:#11150c;border:1px solid #34421d;border-radius:12px;padding:17px}.steps b{display:block;color:#c5ed45;font-size:12px;margin-bottom:15px}.steps strong{font-size:13px;color:#f0f5df}.steps p{color:#9eaa88;font-size:11px;line-height:1.6;margin-bottom:0}footer{text-align:center;color:#7f8b6b;font-size:10px;margin-top:45px}@media(max-width:600px){.shell{padding:48px 16px}.panel,.report{padding:19px}.steps{grid-template-columns:1fr}.report-grid{grid-template-columns:1fr}.top-note{display:none}.report-head{align-items:flex-start;flex-direction:column}}
